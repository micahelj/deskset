#!/bin/bash
# Reverse install: stop the daemon, drop PATH symlink and hooks.

set -uo pipefail

systemctl --user disable --now apexctl.service >/dev/null 2>&1 || true
rm -f "$HOME/.config/systemd/user/apexctl.service"
systemctl --user daemon-reload >/dev/null 2>&1 || true

for dir in "$HOME/.local/bin" /usr/local/bin; do
  target="$dir/apexctl"
  if [[ -L $target ]]; then
    rm -f "$target"
    echo "Removed $target"
  fi
done

rm -f "$HOME/.config/omarchy/hooks/theme-set.d/apply-keyboard-rgb"
rm -f "$HOME/.config/omarchy/hooks/post-boot.d/apexctl"

# Marked blocks in bindings.lua that call apexctl, which is gone now:
# apex-mouse is added by `apexctl mouse --button` (the mouse's onboard profile
# keeps its mapping; `apexctl mouse --restore-buttons` first if you want the
# original buttons back), apex-super and apex-cheatsheet by hand from the README.
bindings="$HOME/.config/hypr/bindings.lua"
for block in apex-mouse apex-super apex-cheatsheet; do
  if [[ -f $bindings ]] && grep -q "^-- \[$block\]" "$bindings"; then
    sed -i "/^-- \[$block\]/,/^-- \[\/$block\]/d" "$bindings"
    echo "Removed the $block block from $bindings"
  fi
done

echo "Done. Then run: omarchy plugin remove io.github.micahelj.deskset"
echo "User config kept at ~/.config/omarchy/apex.json"
