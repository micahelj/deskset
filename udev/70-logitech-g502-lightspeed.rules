# Logitech G502 Lightspeed mouse lighting (HID++), for `apexctl mouse`.
# Wireless: the mouse's own hidraw node under the Lightspeed receiver
# (product 407F), not the receiver itself, so a Logitech keyboard paired to the
# same receiver stays root-only. Wired: the HID++ interface of the cabled
# mouse (product C08D). Either node also carries the mouse's own buttons and
# G-key macros, never another keyboard's typing.
# Install with:
#   sudo cp 70-logitech-g502-lightspeed.rules /etc/udev/rules.d/
#   sudo udevadm control --reload && sudo udevadm trigger
SUBSYSTEM=="hidraw", KERNELS=="0003:046D:407F.*", DRIVERS=="logitech-hidpp-device", TAG+="uaccess"
SUBSYSTEM=="hidraw", ENV{ID_VENDOR_ID}=="046d", ENV{ID_MODEL_ID}=="c08d", ENV{ID_USB_INTERFACE_NUM}=="01", TAG+="uaccess"
